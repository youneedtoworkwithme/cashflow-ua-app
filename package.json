{
  "name": "cashflow-ua-app",
  "version": "1.0.0",
  "description": "Cashflow UA — кросплатформний фінансовий симулятор для iOS, Android, Windows та macOS",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "desktop:start": "electron .",
    "desktop:build": "electron-builder",
    "cap:sync": "npx cap sync",
    "android:add": "npx cap add android",
    "ios:add": "npx cap add ios"
  },
  "build": {
    "appId": "ua.cashflow.lviv",
    "productName": "Cashflow UA",
    "files": ["electron/**/*", "www/**/*", "assets/**/*"],
    "win": { "target": ["nsis", "portable"], "icon": "assets/icon-512.png" },
    "mac": { "target": ["dmg"], "icon": "assets/icon-1024.png", "category": "public.app-category.games" },
    "linux": { "target": ["AppImage"], "icon": "assets/icon-512.png" }
  },
  "dependencies": {
    "@capacitor/android": "^6.1.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/splash-screen": "^6.0.2",
    "@capacitor/status-bar": "^6.0.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
